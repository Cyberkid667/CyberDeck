# Copie ce fichier en .env et remplis-le. Ne partage jamais .env : il contient tes clés.

# --- Claude -----------------------------------------------------------------
# Clé API : https://platform.claude.com/ (Settings > API keys)
ANTHROPIC_API_KEY=
# Modèle et niveau de réflexion. "low" = réponses rapides, idéal pour la voix.
# Pour aller plus vite et moins cher : ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low

# --- Liste de courses ---------------------------------------------------------
# local = fichier data/liste_locale.json (pour tester sans toucher à Keep)
# keep  = ta vraie liste Google Keep
GROCERY_BACKEND=local

KEEP_EMAIL=
# Jeton maître Google : python tools/get_master_token.py
KEEP_MASTER_TOKEN=
# Titre exact de la note-liste dans Keep (majuscules/minuscules ignorées)
KEEP_LIST_TITLE=GROCERIES
# Optionnel : identifiant de la note si plusieurs listes portent le même titre
KEEP_LIST_ID=
# true pour ajouter les nouveaux articles en haut de la liste (comme le réglage Keep)
KEEP_NEW_ITEMS_ON_TOP=false

# --- Assistant ----------------------------------------------------------------
ASSISTANT_NAME=Cuistot
# Une conversation (question / réponse) est oubliée après ce nombre de secondes de silence
ASSISTANT_CONVERSATION_TIMEOUT=120
# Mot de passe de l'API. Obligatoire dès que le serveur est joignable depuis internet
# (tunnel Cloudflare...). Ouvre ensuite la page avec https://.../?token=CE_JETON
ASSISTANT_TOKEN=
